{
  "info": {
    "name": "Learner API",
    "description": "Manual smoke-test requests, mirrors doc/api/curl-requests.md. Import via Bruno: Import Collection -> Postman Collection.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    { "key": "baseUrl", "value": "http://localhost:8080/v1" }
  ],
  "item": [
    {
      "name": "Catalog (real, DB-backed)",
      "item": [
        {
          "name": "Get Languages",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/languages",
              "host": ["{{baseUrl}}"],
              "path": ["languages"]
            }
          }
        },
        {
          "name": "Get Lists (sv from en)",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/lists?target=sv&base=en",
              "host": ["{{baseUrl}}"],
              "path": ["lists"],
              "query": [
                { "key": "target", "value": "sv" },
                { "key": "base", "value": "en" }
              ]
            }
          }
        },
        {
          "name": "Get Lists (no translation coverage -> [])",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/lists?target=sv&base=ru",
              "host": ["{{baseUrl}}"],
              "path": ["lists"],
              "query": [
                { "key": "target", "value": "sv" },
                { "key": "base", "value": "ru" }
              ]
            }
          }
        },
        {
          "name": "Get List Detail",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/lists/1",
              "host": ["{{baseUrl}}"],
              "path": ["lists", "1"]
            }
          }
        },
        {
          "name": "Get List Detail (unknown -> 404)",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/lists/9999",
              "host": ["{{baseUrl}}"],
              "path": ["lists", "9999"]
            }
          }
        },
        {
          "name": "Get Language Pairs (secured counterpart to Public Init)",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/language-pairs",
              "host": ["{{baseUrl}}"],
              "path": ["language-pairs"]
            }
          }
        }
      ]
    },
    {
      "name": "Progress (real, DB-backed)",
      "item": [
        {
          "name": "Get Home",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/me/home",
              "host": ["{{baseUrl}}"],
              "path": ["me", "home"]
            }
          }
        },
        {
          "name": "Get Stats",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/me/stats",
              "host": ["{{baseUrl}}"],
              "path": ["me", "stats"]
            }
          }
        }
      ]
    },
    {
      "name": "Auth (register/reset real, login/refresh/logout stub)",
      "item": [
        {
          "name": "Register (creates account, emails confirmation code)",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"test@example.com\",\n  \"password\": \"password123\"\n}",
              "options": { "raw": { "language": "json" } }
            },
            "url": {
              "raw": "{{baseUrl}}/auth/register",
              "host": ["{{baseUrl}}"],
              "path": ["auth", "register"]
            }
          }
        },
        {
          "name": "Register duplicate email (-> 409 EMAIL_TAKEN)",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"test@example.com\",\n  \"password\": \"password123\"\n}",
              "options": { "raw": { "language": "json" } }
            },
            "url": {
              "raw": "{{baseUrl}}/auth/register",
              "host": ["{{baseUrl}}"],
              "path": ["auth", "register"]
            }
          }
        },
        {
          "name": "Login (stub - always succeeds, does not verify password)",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"test@example.com\",\n  \"password\": \"password123\"\n}",
              "options": { "raw": { "language": "json" } }
            },
            "url": {
              "raw": "{{baseUrl}}/auth/login",
              "host": ["{{baseUrl}}"],
              "path": ["auth", "login"]
            }
          }
        },
        {
          "name": "Refresh (stub)",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"refreshToken\": \"dummy-refresh-token\"\n}",
              "options": { "raw": { "language": "json" } }
            },
            "url": {
              "raw": "{{baseUrl}}/auth/refresh",
              "host": ["{{baseUrl}}"],
              "path": ["auth", "refresh"]
            }
          }
        },
        {
          "name": "Logout (stub)",
          "request": {
            "method": "POST",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/auth/logout",
              "host": ["{{baseUrl}}"],
              "path": ["auth", "logout"]
            }
          }
        },
        {
          "name": "Reset - Request code (always 204, never leaks account existence)",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"test@example.com\"\n}",
              "options": { "raw": { "language": "json" } }
            },
            "url": {
              "raw": "{{baseUrl}}/auth/reset/request",
              "host": ["{{baseUrl}}"],
              "path": ["auth", "reset", "request"]
            }
          }
        },
        {
          "name": "Reset - Confirm with code (use code from server logs - LoggingEmailService)",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"test@example.com\",\n  \"code\": \"1234\",\n  \"newPassword\": \"newpassword123\"\n}",
              "options": { "raw": { "language": "json" } }
            },
            "url": {
              "raw": "{{baseUrl}}/auth/reset/confirm",
              "host": ["{{baseUrl}}"],
              "path": ["auth", "reset", "confirm"]
            }
          }
        },
        {
          "name": "Reset - Confirm with wrong code (-> 400 INVALID_OR_EXPIRED_CODE)",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"test@example.com\",\n  \"code\": \"0000\",\n  \"newPassword\": \"newpassword123\"\n}",
              "options": { "raw": { "language": "json" } }
            },
            "url": {
              "raw": "{{baseUrl}}/auth/reset/confirm",
              "host": ["{{baseUrl}}"],
              "path": ["auth", "reset", "confirm"]
            }
          }
        },
        {
          "name": "Reset - Request link (code-less; also sends fraud-notification email)",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"test@example.com\"\n}",
              "options": { "raw": { "language": "json" } }
            },
            "url": {
              "raw": "{{baseUrl}}/auth/reset/link",
              "host": ["{{baseUrl}}"],
              "path": ["auth", "reset", "link"]
            }
          }
        },
        {
          "name": "Reset - Confirm with link token (use token from server logs)",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"test@example.com\",\n  \"token\": \"<paste token here>\",\n  \"newPassword\": \"viatoken123\"\n}",
              "options": { "raw": { "language": "json" } }
            },
            "url": {
              "raw": "{{baseUrl}}/auth/reset/confirm",
              "host": ["{{baseUrl}}"],
              "path": ["auth", "reset", "confirm"]
            }
          }
        }
      ]
    },
    {
      "name": "Account (real, DB-backed)",
      "item": [
        {
          "name": "Get Me",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/me",
              "host": ["{{baseUrl}}"],
              "path": ["me"]
            }
          }
        },
        {
          "name": "Update Me (name + learning pair)",
          "request": {
            "method": "PATCH",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"name\": \"Demo User\",\n  \"learnBaseLang\": \"en\",\n  \"learnTargetLang\": \"sv\"\n}",
              "options": { "raw": { "language": "json" } }
            },
            "url": {
              "raw": "{{baseUrl}}/me",
              "host": ["{{baseUrl}}"],
              "path": ["me"]
            }
          }
        },
        {
          "name": "Update Me - unsupported pair (-> 400 UNSUPPORTED_PAIR)",
          "request": {
            "method": "PATCH",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"learnBaseLang\": \"sv\",\n  \"learnTargetLang\": \"en\"\n}",
              "options": { "raw": { "language": "json" } }
            },
            "url": {
              "raw": "{{baseUrl}}/me",
              "host": ["{{baseUrl}}"],
              "path": ["me"]
            }
          }
        },
        {
          "name": "Delete Me (cascades user_list/list_progress/sessions/attempt)",
          "request": {
            "method": "DELETE",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/me",
              "host": ["{{baseUrl}}"],
              "path": ["me"]
            }
          }
        }
      ]
    },
    {
      "name": "Public (no auth)",
      "item": [
        {
          "name": "Get Public Init (bootstrap data - languagePairs today, more later)",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/public/init",
              "host": ["{{baseUrl}}"],
              "path": ["public", "init"]
            }
          }
        }
      ]
    },
    {
      "name": "Enrollment (real, DB-backed)",
      "item": [
        {
          "name": "Enroll (list 1, already enrolled -> 200)",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"baseLang\": \"en\"\n}",
              "options": { "raw": { "language": "json" } }
            },
            "url": {
              "raw": "{{baseUrl}}/lists/1/enroll",
              "host": ["{{baseUrl}}"],
              "path": ["lists", "1", "enroll"]
            }
          }
        },
        {
          "name": "Enroll (list 2 - one active enrollment per user, this EVICTS list 1 -> 201)",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"baseLang\": \"en\"\n}",
              "options": { "raw": { "language": "json" } }
            },
            "url": {
              "raw": "{{baseUrl}}/lists/2/enroll",
              "host": ["{{baseUrl}}"],
              "path": ["lists", "2", "enroll"]
            }
          }
        },
        {
          "name": "Re-enroll list 1 (list 1 was evicted, not completed, so this recreates it -> 201)",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"baseLang\": \"en\"\n}",
              "options": { "raw": { "language": "json" } }
            },
            "url": {
              "raw": "{{baseUrl}}/lists/1/enroll",
              "host": ["{{baseUrl}}"],
              "path": ["lists", "1", "enroll"]
            }
          }
        },
        {
          "name": "Get Enrollments",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/enrollments",
              "host": ["{{baseUrl}}"],
              "path": ["enrollments"]
            }
          }
        },
        {
          "name": "Get Enrollment",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/enrollments/1",
              "host": ["{{baseUrl}}"],
              "path": ["enrollments", "1"]
            }
          }
        },
        {
          "name": "Get Enrollment (unknown -> 404)",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/enrollments/9999",
              "host": ["{{baseUrl}}"],
              "path": ["enrollments", "9999"]
            }
          }
        },
        {
          "name": "Unenroll",
          "request": {
            "method": "DELETE",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/enrollments/1",
              "host": ["{{baseUrl}}"],
              "path": ["enrollments", "1"]
            }
          }
        },
        {
          "name": "Get Enrollment Progress",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/enrollments/1/progress",
              "host": ["{{baseUrl}}"],
              "path": ["enrollments", "1", "progress"]
            }
          }
        }
      ]
    },
    {
      "name": "Session (real, DB-backed)",
      "item": [
        {
          "name": "Create Session (returns items: introduce cards + exercises)",
          "request": {
            "method": "POST",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/enrollments/1/sessions",
              "host": ["{{baseUrl}}"],
              "path": ["enrollments", "1", "sessions"]
            }
          }
        },
        {
          "name": "Create Session (unknown enrollment -> 404)",
          "request": {
            "method": "POST",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/enrollments/9999/sessions",
              "host": ["{{baseUrl}}"],
              "path": ["enrollments", "9999", "sessions"]
            }
          }
        },
        {
          "name": "Complete Session (use sessionId from Create Session response; may auto-complete the list if all words are now mastered)",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"results\": [\n    {\n      \"itemId\": \"it_01\",\n      \"lexemeId\": 1,\n      \"exerciseType\": \"en_ett\",\n      \"formType\": null,\n      \"isCorrect\": true,\n      \"elapsedMs\": 1800\n    }\n  ]\n}",
              "options": { "raw": { "language": "json" } }
            },
            "url": {
              "raw": "{{baseUrl}}/sessions/a3f2c9d1/complete",
              "host": ["{{baseUrl}}"],
              "path": ["sessions", "a3f2c9d1", "complete"]
            }
          }
        },
        {
          "name": "Complete Session (unknown sessionId -> 404)",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"results\": []\n}",
              "options": { "raw": { "language": "json" } }
            },
            "url": {
              "raw": "{{baseUrl}}/sessions/unknown-session-id/complete",
              "host": ["{{baseUrl}}"],
              "path": ["sessions", "unknown-session-id", "complete"]
            }
          }
        },
        {
          "name": "Submit Answers (incremental, not implemented -> 501)",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"results\": [\n    {\n      \"itemId\": \"it_01\",\n      \"lexemeId\": 1,\n      \"exerciseType\": \"en_ett\",\n      \"formType\": null,\n      \"isCorrect\": true,\n      \"elapsedMs\": 1800\n    }\n  ]\n}",
              "options": { "raw": { "language": "json" } }
            },
            "url": {
              "raw": "{{baseUrl}}/sessions/a3f2c9d1/answers",
              "host": ["{{baseUrl}}"],
              "path": ["sessions", "a3f2c9d1", "answers"]
            }
          }
        }
      ]
    }
  ]
}
